{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"outDir": "dist",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true
	},
	"include": ["src/**/*", "forge.config.ts", "vite.*.config.ts"]
}
